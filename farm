-- ============================================
-- ОСНОВНОЙ ЦИКЛ (30 секунд сбора -> хоп)
-- ============================================
local function MainLoop()
    while Enabled do
        wait(0.5)

        if IsHopping then
            Status.Text = "Хопаем..."
            continue
        end

        -- Проверяем время на сервере
        local elapsed = tick() - StartTime
        local remaining = math.max(0, Config.FarmTime - math.floor(elapsed))
        TimerLabel.Text = "До хопа: " .. remaining .. " сек"

        -- Если прошло 30 секунд — хопаем
        if elapsed >= Config.FarmTime then
            Status.Text = "Время вышло — хопаем!"
            print("[SWILL] 30 секунд истекли — хоп")
            StartTime = tick()
            spawn(InfiniteHop)
            continue
        end

        -- Ищем фрукт
        local fruit = FindFruit()

        if fruit then
            Status.Text = "Найден: " .. fruit.Name
            print("[SWILL] Найден фрукт: " .. fruit.Name)

            local success = TeleportToFruit(fruit)
            if success then
                wait(0.4)
                CollectFruit(fruit)
                Status.Text = "Собрал: " .. fruit.Name
                print("[SWILL] Собрал: " .. fruit.Name)
                wait(0.5)
            end
        else
            Status.Text = "Фруктов нет — ищем..."
            wait(Config.ScanInterval)
        end
    end
end

